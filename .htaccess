<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward every request into the Laravel public directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to application and environment files.
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js)$">
    Require all denied
</FilesMatch>
